# Bland.ai Configuration
BLAND_API_KEY=your_bland_api_key
BLAND_PHONE_NUMBER_ID=your_bland_phone_number_id

# Alternative: Vapi.ai
VAPI_API_KEY=your_vapi_api_key

# App Configuration
PORT=3000
NODE_ENV=development

# Default Authority Numbers (Greece)
# User should configure their local numbers
DEFAULT_TROCHIA_NUMBER=+302106411111
DEFAULT_DIMOTIKI_NUMBER=+302105277000

# Mock Mode (set to true for development without actual calls)
MOCK_CALLS=true

# Webhook URL for call completion callbacks
WEBHOOK_BASE_URL=http://localhost:3000
